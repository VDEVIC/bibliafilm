# Cabeceras de entrega de bibliafilm.com (Cloudflare Pages).
# css/js van con ?v=… (publicar.sh cambia la versión en cada publicación): pueden guardarse un año.
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
# imágenes: una semana (no llevan versión en el nombre)
/img/*
  Cache-Control: public, max-age=604800
/nuevo/assets/*
  Cache-Control: public, max-age=604800
/media/*
  Cache-Control: public, max-age=604800
# los datos se leen siempre frescos (la web los pide con ?fecha)
/*.json
  Cache-Control: no-cache
# manifest PWA (Añadir a pantalla de inicio)
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=604800
# Laboratorio de tirones (/prueba/): fuera de buscadores. La 3 y la 4 con no-transform, para que Cloudflare no les meta su analítica.
/prueba/*
  X-Robots-Tag: noindex
/prueba/3/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/prueba/4/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
# Plan de ingresos de Vic (/plan/): fuera de buscadores
/plan/*
  X-Robots-Tag: noindex
